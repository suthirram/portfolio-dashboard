{
  "permissions": {
    "deny": [
      "Read(scripts/seed.env)",
      "Edit(scripts/seed.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/rules/guard-claude-bash.sh",
            "timeout": 30,
            "statusMessage": "Checking project rules"
          }
        ]
      }
    ]
  }
}
