@@ -0,0 +1,74 @@
+import { useState } from 'react'
+import type { TransactionType } from '../../types'
+import { DecimalInput } from '../../components/DecimalInput'
+import { formatDate } from '../../lib/formDates'
+import { NEW_TYPES, TYPE_LABEL, useHoldingLedger, type LedgerProps } from '../../features/holdings/useHoldingLedger'
+import { Ui2Dialog } from '../shell/Ui2Dialog'
+
+export function Ui2HoldingLedger({ holding, onClose, onChanged, userId }: LedgerProps) {
+  const [editor, setEditor] = useState(false)
+  const { sym, txns, loading, err, form, setForm, editingId, saving, confirm, setConfirm, resetForm,
+    recompute, startEdit, submit, remove, money, num, isCorporate, isMerger, isOpening, impliedCostPerShare
+  } = useHoldingLedger({ holding, userId, onChanged })
+  const ledgerForm = <form className="ui2-form" onSubmit={async event => {
+    if (await submit(event)) setEditor(false)
+  }}>
+    <div className="ui2-formrow">
+      <label>Event type<select value={form.type} disabled={isOpening} onChange={event =>
+        setForm({ ...form, type: event.target.value as TransactionType })}>
+        {(isOpening ? ['opening'] : NEW_TYPES).map(type => <option key={type} value={type}>{TYPE_LABEL[type]}</option>)}
+      </select></label>
+      <label>Date<input type="date" required value={form.date} onChange={event => setForm({ ...form, date: event.target.value })} /></label>
+    </div>
+    {!isCorporate && !isMerger && <>
+      {form.type !== 'dividend' && <div className="ui2-formrow">
+        <label>Shares<DecimalInput value={form.quantity} onValueChange={quantity => recompute({ quantity })} /></label>
+        <label>Price / share ({sym}, optional)<DecimalInput value={form.price} onValueChange={price => recompute({ price })} /></label>
+      </div>}
+      <label>Total amount ({sym})<DecimalInput value={form.amount} onValueChange={amount => setForm({ ...form, amount })} /></label>
+      {impliedCostPerShare !== null && <p className="ui2-dialog-note">Implied cost/share: {money(impliedCostPerShare)}</p>}
+    </>}
+    {isCorporate && <label>Ratio (new shares per old)<DecimalInput value={form.ratio} onValueChange={ratio => setForm({ ...form, ratio })} /></label>}
+    {isOpening && <label>Realised P&amp;L seed ({sym})<DecimalInput allowNegative value={form.realized}
+      onValueChange={realized => setForm({ ...form, realized })} /></label>}
+    {isMerger && <p className="ui2-dialog-note">Merger records an audit event. Record a sell and a buy for changes to the position.</p>}
+    <label>Notes<input value={form.notes} onChange={event => setForm({ ...form, notes: event.target.value })} /></label>
+    <div className="ui2-dialog-actions">
+      <button type="button" className="ui2-btn" disabled={saving} onClick={() => { resetForm(); setConfirm(null); setEditor(false) }}>Cancel</button>
+      <button className="ui2-btn ui2-btn-primary" disabled={saving}>Save event</button>
+    </div>
+  </form>
+  const title = editor
+    ? `${editingId ? 'Edit' : 'Add'} event · ${holding.script}`
+    : `${holding.script} · transaction ledger`
+  return <Ui2Dialog key={editor ? 'editor' : 'list'} title={title} busy={saving} onClose={onClose} wide>
+    {err && <p role="alert" className="ui2-form-error">{err}</p>}
+    {editor ? <>
+      {ledgerForm}
+      {editingId && (confirm === editingId
+        ? <div className="ui2-dialog-actions">
+            <button className="ui2-btn" disabled={saving} onClick={() => setConfirm(null)}>Keep event</button>
+            <button className="ui2-btn ui2-btn-danger" disabled={saving} onClick={async () => {
+              if (await remove(editingId)) { resetForm(); setEditor(false) }
+            }}>Confirm delete</button>
+          </div>
+        : <button className="ui2-btn ui2-btn-danger" disabled={saving} onClick={() => setConfirm(editingId)}>Delete event</button>)}
+    </> : <>
+      <p className="ui2-dialog-note">{holding.symbol} · {holding.currency}</p>
+      <div className="table-scroll"><table className="ui2-table">
+        <thead><tr>{['Date', 'Type', 'Shares', 'Amount', 'Actions'].map(label => <th scope="col" key={label}>{label}</th>)}</tr></thead>
+        <tbody>{txns.toSorted((left, right) => (right.date || '').localeCompare(left.date || '')).map(txn =>
+          <tr key={txn.id}>
+            <td>{txn.date ? formatDate(txn.date) : '—'}</td><td>{TYPE_LABEL[txn.type || '']}</td>
+            <td>{num(txn.quantity)}</td><td>{money(txn.amount)}</td>
+            <td><button className="ui2-btn" onClick={() => { startEdit(txn); setEditor(true) }}
+              aria-label={`Edit ${TYPE_LABEL[txn.type || '']} on ${txn.date ? formatDate(txn.date) : 'unknown date'}`}>Edit</button></td>
+          </tr>)}</tbody>
+      </table></div>
+      {loading ? <p>Loading…</p> : !err && !txns.length && <p>No transactions yet.</p>}
+      <div className="ui2-dialog-actions"><button className="ui2-btn ui2-btn-primary" onClick={() => {
+        resetForm(); setEditor(true)
+      }}>Add event</button></div>
+    </>}
+  </Ui2Dialog>
+}
