# Config for scripts/seed-max.sh and scripts/delete-max.sh.
#
# Copy to scripts/seed.env and fill in per environment; both scripts source
# scripts/seed.env automatically (override the path with SEED_ENV_FILE=...).
# Values here take precedence over the scripts' built-in defaults. seed.env is
# gitignored — it holds credentials, so never commit it.
#
#   cp scripts/seed.env.example scripts/seed.env
#   # edit scripts/seed.env, then:
#   ./scripts/seed-max.sh
#   ./scripts/delete-max.sh

# --- Backend -----------------------------------------------------------------
# Base URL of the running backend. Non-localhost requires CONFIRM=yes below.
API=http://localhost:8080

# Demo account password. The default is fine for a throwaway local DB, but on
# a shared dev/prod deployment set a strong, unique value so the demo login
# isn't a known-credential account. (Data stays isolated per-user either way;
# this only controls who can log in as the demo user.)
# PASSWORD=change-me-on-shared-envs

# Required to seed/delete a NON-local environment (dev/prod). Leave unset/blank
# for local. Guards against accidentally writing to a real DB.
# CONFIRM=yes

# --- MongoDB -----------------------------------------------------------------
# LOCAL: leave MONGO_URI blank to use the dev docker container below.
# DEV/PROD: set the Atlas connection string (needs a local mongosh on PATH and
# this host on the Atlas IP allow-list).
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/portfolio

MONGO_CONTAINER=portfolio_mongo_dev

# MUST match the backend's MONGODB_DATABASE. The scripts write history
# snapshots straight to this db (via getSiblingDB), and the app only reads
# client.Database(MONGODB_DATABASE) — if they differ, seeded history is
# inserted but invisible on the History page. Default matches the app default.
MONGO_DB=portfolio

# --- Postgres (gold) ---------------------------------------------------------
# Only delete-max.sh uses these, to clear the gold price series. LOCAL default
# reaches the dev container; set the real URI (+ a local psql) for dev/prod.
POSTGRES_URI=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable
PG_CONTAINER=portfolio_postgres_dev
PG_DB=portfolio
PG_USER=portfolio

# --- Seed shape --------------------------------------------------------------
HISTORY_DAYS=90
