# Copy to .env.local and adjust
VITE_API_URL=http://localhost:8080

# Production (Cloudflare Pages): leave VITE_API_URL UNSET. The app calls the
# API same-origin at /api, which functions/api/[[path]].ts proxies to Cloud Run.
# Set the Cloud Run URL in the Pages project's API_ORIGIN env var instead.
# A cross-origin VITE_API_URL makes the session cookie third-party, which iOS
# Safari/Chrome block — login then silently fails on iPhone/iPad.
